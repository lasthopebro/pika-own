{
  "manifest_version": 3,
  "name": "pika-own",
  "version": "0.7.0",
  "description": "Eigenes Lesezeichen-Board mit Schnellwahl aus dem Verlauf, eigenen Seitenleisten-Ansichten und KI-Tab-Sortierung (Ollama/OpenRouter).",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["bookmarks", "history", "topSites", "storage", "unlimitedStorage", "tabs", "alarms", "notifications", "contextMenus", "sidePanel", "scripting", "tabGroups"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*", "https://openrouter.ai/*"],
  "background": { "scripts": ["background.js"], "service_worker": "background.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_title": "pika-own Seitenleiste", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "sidebar_action": { "default_title": "pika-own", "default_panel": "sidebar.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "commands": {
    "save-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Aktuelle Seite in pika-own speichern" },
    "toggle-bar": { "suggested_key": { "default": "Alt+Shift+B" }, "description": "Leiste auf Webseiten ein-/ausklappen" },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "pika-own Seitenleiste öffnen" },
    "_execute_sidebar_action": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "pika-own Seitenleiste öffnen (Firefox)" }
  },
  "side_panel": { "default_path": "sidebar.html" },
  "browser_specific_settings": { "gecko": { "id": "pika-own@local", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"], "optional": ["browsingActivity"] } } }
}
